<section class="gift-banner" id="gift-banner-{{ section.id }}">
  <header class="gift-banner__header">
    <button class="gift-banner__menu" type="button" aria-label="Open menu"><span></span><span></span><span></span></button>
    <strong>{{ section.settings.brand_name }}</strong>
    <p>{{ section.settings.header_text }}</p>
    <a href="#gift-guide-grid" class="gift-banner__header-button">{{ section.settings.header_button }} <span>-></span></a>
  </header>

  <div class="gift-banner__content">
    <div class="gift-banner__art">
      {% for block in section.blocks %}
        {% if block.settings.image != blank %}
          <div class="gift-banner__art-item" {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 700 | image_tag: loading: 'eager', alt: block.settings.alt_text }}
          </div>
        {% endif %}
      {% endfor %}
    </div>
    <div class="gift-banner__copy">
      <h1>{{ section.settings.heading }}</h1>
      <div class="gift-banner__description">{{ section.settings.description }}</div>
      <a class="gift-banner__button" href="#gift-guide-grid">{{ section.settings.hero_button }} <span>-></span></a>
    </div>
  </div>
  <p class="gift-banner__announcement">{{ section.settings.announcement_text }}</p>
</section>

<style>
  #gift-banner-{{ section.id }}{--ink:#111;--paper:#efefeb;--accent:#e8d55d;background:var(--paper);color:var(--ink);padding:18px;max-width:1250px;margin:0 auto;font-family:var(--font-body-family,sans-serif)}
  #gift-banner-{{ section.id }} *{box-sizing:border-box}#gift-banner-{{ section.id }} .gift-banner__header{display:grid;grid-template-columns:58px 1fr auto auto;align-items:center;gap:18px;min-height:68px;border-bottom:1px solid #1113}#gift-banner-{{ section.id }} .gift-banner__menu{width:42px;padding:8px;border:0;background:none;display:grid;gap:4px;cursor:pointer}#gift-banner-{{ section.id }} .gift-banner__menu span{height:2px;background:var(--ink)}#gift-banner-{{ section.id }} strong{font-family:var(--font-heading-family,serif);font-size:clamp(1.3rem,1.8vw,2.75rem);text-align:left}#gift-banner-{{ section.id }} .gift-banner__header p{margin:0;font-size:.82rem;text-align:center}#gift-banner-{{ section.id }} .gift-banner__header-button{background:var(--accent);color:var(--ink);padding:11px 18px;text-decoration:none;font-size:.72rem;font-weight:700;letter-spacing:.08em}#gift-banner-{{ section.id }} .gift-banner__content{display:grid;grid-template-columns:.9fr 1.6fr;gap:28px;align-items:center;padding-top:20px}#gift-banner-{{ section.id }} .gift-banner__art{min-height:620px;display:grid;grid-template-columns:repeat(4,1fr);grid-auto-rows:1fr;gap:0;overflow:hidden}#gift-banner-{{ section.id }} .gift-banner__art-item{min-width:0;min-height:0;overflow:hidden}#gift-banner-{{ section.id }} .gift-banner__art-item img{width:100%;height:100%;object-fit:cover}#gift-banner-{{ section.id }} .gift-banner__copy{padding:0 0 22px 8px}#gift-banner-{{ section.id }} h1{font-family:var(--font-heading-family,serif);font-size:clamp(2.7rem,4vw,5rem);line-height:.9;letter-spacing:-.06em;margin:0}#gift-banner-{{ section.id }} .gift-banner__description{max-width:430px;margin:18px 0 28px;line-height:1.5}#gift-banner-{{ section.id }} .gift-banner__button{display:inline-flex;align-items:center;gap:18px;background:var(--ink);color:#fff;padding:16px 20px;text-decoration:none;font-size:.8rem;font-weight:700;letter-spacing:.08em;transition:transform .2s ease,background .2s ease}#gift-banner-{{ section.id }} .gift-banner__button span{font-size:1.4rem}#gift-banner-{{ section.id }} .gift-banner__button:hover{background:#e8d55d;color:#111;transform:translateX(5px)}#gift-banner-{{ section.id }} .gift-banner__header-button:hover{animation:gift-banner-pulse .6s ease}@keyframes gift-banner-pulse{50%{transform:translateY(-3px)}}#gift-banner-{{ section.id }} .gift-banner__announcement{margin:0;padding:12px;text-align:center;border-top:1px solid #1113;font-size:.78rem;letter-spacing:.03em}@media(max-width:900px){#gift-banner-{{ section.id }} .gift-banner__header{grid-template-columns:50px 1fr auto}#gift-banner-{{ section.id }} .gift-banner__header p{display:none}#gift-banner-{{ section.id }} .gift-banner__content{grid-template-columns:1fr}#gift-banner-{{ section.id }} .gift-banner__copy{padding-left:0}#gift-banner-{{ section.id }} .gift-banner__art{min-height:430px}}@media(max-width:560px){#gift-banner-{{ section.id }}{padding:10px 12px 30px}#gift-banner-{{ section.id }} .gift-banner__header{grid-template-columns:42px 1fr auto;gap:10px}#gift-banner-{{ section.id }} strong{font-size:1.1rem}#gift-banner-{{ section.id }} .gift-banner__header-button{padding:9px 10px;font-size:.6rem}#gift-banner-{{ section.id }} .gift-banner__art{min-height:300px;grid-template-columns:repeat(3,1fr)}}
</style>

{% schema %}
{
  "name": "Gift guide banner",
  "tag": "section",
  "class": "section-gift-guide-banner",
  "settings": [
    { "type": "text", "id": "brand_name", "label": "Brand name", "default": "TISSO VISON" },
    { "type": "text", "id": "header_text", "label": "Header text", "default": "Find the ideal gift for loved ones." },
    { "type": "text", "id": "header_button", "label": "Header button", "default": "CHOOSE GIFT" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "The Gift Guide" },
    { "type": "richtext", "id": "description", "label": "Description", "default": "<p>Discover joy: Your ultimate holiday gift destination. Explore our curated selection and find the perfect gifts to delight your loved ones this holiday season.</p>" },
    { "type": "text", "id": "hero_button", "label": "Hero button", "default": "SHOP NOW" },
    { "type": "text", "id": "announcement_text", "label": "Bottom announcement", "default": "SUSTAINABLE, ETHICALLY MADE CLOTHES IN SIZES XXS TO 6XL" }
  ],
  "blocks": [
    { "type": "image", "name": "Product illustration", "limit": 12, "settings": [
      { "type": "image_picker", "id": "image", "label": "Image" },
      { "type": "text", "id": "alt_text", "label": "Alt text", "default": "Gift guide product illustration" }
    ]}
  ],
  "presets": [{ "name": "Gift guide banner" }]
}
{% endschema %}